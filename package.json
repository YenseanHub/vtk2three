{
  "name": "vtk2three",
  "version": "0.1.0",
  "description": "Convert vtk.js actor/mapper data into three.js objects",
  "type": "module",
  "files": ["dist"],
  "main": "./dist/vtk2three.cjs",
  "module": "./dist/vtk2three.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vtk2three.js",
      "require": "./dist/vtk2three.cjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "prepack": "npm run build:lib",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@kitware/vtk.js": "^38.0.0",
    "three": ">=0.180.0"
  },
  "devDependencies": {
    "@kitware/vtk.js": "^38.0.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.3.0",
    "three": "^0.187.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "web-vitals": "^2.1.4"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
